# sby/security.sby — formal verification of fault_monitor (tapeout audit §1.3c)
# Properties are SVA in sby/security_fv.sv (kept out of the Verilog-2001 RTL).

[options]
mode bmc
depth 25

[engines]
smtbmc boolector

[script]
read_verilog -formal fault_monitor.v
read_verilog -formal -sv security_fv.sv
prep -top security_fv -flatten

[files]
../rtl/security/fault_monitor.v
security_fv.sv

# sby/snn.sby — formal verification of snn_tile_256 (tapeout audit §1.3c)
# NUM_NEURONS=4 for tractable BMC. Properties are SVA in sby/snn_fv.sv.

[options]
mode bmc
depth 30

[engines]
smtbmc boolector

[script]
read_verilog -formal lif_ttfs_neuron_v1_1.v
read_verilog -formal snn_tile_256.v
read_verilog -formal -sv snn_fv.sv
prep -top snn_fv

[files]
../rtl/snn/lif_ttfs_neuron_v1_1.v
../rtl/snn/snn_tile_256.v
snn_fv.sv

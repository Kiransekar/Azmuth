# sby/power.sby — formal verification of orchestrator (tapeout audit §1.3c)
# Properties are SVA in sby/power_fv.sv (kept out of the Verilog-2001 RTL).

[options]
mode bmc
depth 25

[engines]
smtbmc boolector

[script]
read_verilog -formal orchestrator.v
read_verilog -formal -sv power_fv.sv
prep -top power_fv

[files]
../rtl/power/orchestrator.v
power_fv.sv

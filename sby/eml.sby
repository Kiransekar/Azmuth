# sby/eml.sby — formal verification of eml_unit (tapeout audit §1.3c)
# Properties are SVA in sby/eml_fv.sv (kept out of the Verilog-2001 RTL).

[options]
mode bmc
depth 20

[engines]
smtbmc boolector

[script]
read_verilog -formal eml_unit.v
read_verilog -formal -sv eml_fv.sv
prep -top eml_fv -flatten

[files]
../rtl/eml/eml_unit.v
eml_fv.sv
